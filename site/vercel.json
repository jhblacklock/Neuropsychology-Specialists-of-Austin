    { "source": "/:year(20\\d{2})/:month(\\d{2})/:path*", "destination": "/insights/", "permanent": true },

    { "source": "/fees-and-insurance.html", "destination": "/fees-and-payment/", "permanent": true },
    { "source": "/insights/normal-memory-change-and-what-is-not.html", "destination": "/insights/", "permanent": true }
