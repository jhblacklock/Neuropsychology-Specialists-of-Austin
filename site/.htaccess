# Neuropsychology Specialists of Austin
# Apache / cPanel. If the site is served by Netlify or Vercel instead, this
# file is ignored — use _redirects or vercel.json.
#
# GENERATED by tools/redirects/generate.mjs from tools/redirects/redirects.json.
# Edit those, not this file. Every old-site rule corresponds to a URL that
# exists on the old site (its Yoast sitemaps) or on the v1 build.

Options -MultiViews
RewriteEngine On

# ---------------------------------------------------------------------------
# Old site -> new site. This block runs FIRST so that an old URL reaches its
# destination in one hop. A 301 that lands on another 301 leaks signal.
# ---------------------------------------------------------------------------

# v1 pages (August 2026 build) merged into the six-page structure
# became Services
RewriteRule ^neuropsychological-evaluation/?$ /services/ [R=301,L]
# merged into Services
RewriteRule ^the-process/?$ /services/#evaluation-process [R=301,NE,L]
# merged into About
RewriteRule ^our-team/?$ /about/#our-experts [R=301,NE,L]
# merged into the insurance FAQ
RewriteRule ^fees-and-payment/?$ /faqs/#insurance [R=301,NE,L]
# retired: the practice does not provide intervention
RewriteRule ^intervention-services/?$ /faqs/#intervention-services [R=301,NE,L]
# referral details folded into Contact
RewriteRule ^for-referring-providers/?$ /contact/#referrals [R=301,NE,L]

# Old WordPress posts, sent to the nearest topic
# topic match
RewriteRule ^2018/04/02/what-is-neuropsychology/?$ /services/ [R=301,L]
# autism evaluation is a core service
RewriteRule ^2018/04/02/detecting-autism-in-the-very-young/?$ /services/#neuropsychological-evaluations [R=301,NE,L]
# adult brain injury is in scope again
RewriteRule ^2018/04/02/head-injuries-may-lead-to-early-alzheimers/?$ /services/#neuropsychological-evaluations [R=301,NE,L]
# giftedness is now a service
RewriteRule ^2021/01/21/every-child-has-a-gift-it-just-has-to-be-discovered/?$ /services/#giftedness [R=301,NE,L]
RewriteRule ^category/articles/?$ /insights/ [R=301,L]
RewriteRule ^author/stephaniep/?$ /about/#stephanie-paulos [R=301,NE,L]

# People
RewriteRule ^about-us/melissa-bunner-phd/?$ /about/#melissa-bunner [R=301,NE,L]
RewriteRule ^about-us/stephanie-paulos-phd/?$ /about/#stephanie-paulos [R=301,NE,L]
# removed from all materials, see REDIRECTS.md decision 2
RewriteRule ^about-us/david-tucker-phd/?$ /about/ [R=301,L]
# not on the team
RewriteRule ^about-us/greg-allen-phd/?$ /about/ [R=301,L]
# not on the team
RewriteRule ^about-us/connie-walker/?$ /about/ [R=301,L]
RewriteRule ^about-us/?$ /about/ [R=301,L]

# Patient pages
RewriteRule ^general-procedures/?$ /services/#evaluation-process [R=301,NE,L]
RewriteRule ^for-patients/what-is-neuropsychology/?$ /services/ [R=301,L]
RewriteRule ^for-patients/intervention-services/?$ /faqs/#intervention-services [R=301,NE,L]
RewriteRule ^for-patients/billing-and-fees/?$ /faqs/#insurance [R=301,NE,L]
# the office sends the paperwork
RewriteRule ^for-patients/forms/?$ /contact/#make-an-appointment [R=301,NE,L]
# settles REDIRECTS.md decision 1
RewriteRule ^for-patients/patients-medical-records-and-patients-rights/?$ /resources/#medical-records [R=301,NE,L]
# Resources replaces the Links page
RewriteRule ^for-patients/links/?$ /resources/ [R=301,L]
# section hub
RewriteRule ^for-patients/?$ /services/ [R=301,L]
RewriteRule ^directions/?$ /contact/ [R=301,L]
RewriteRule ^contact-us/?$ /contact/ [R=301,L]

# The retired checkout plugin
RewriteRule ^wpi-checkout/wpinv-transaction-failed/?$ /faqs/#insurance [R=301,NE,L]
RewriteRule ^wpi-checkout/wpinv-subscriptions/?$ /faqs/#insurance [R=301,NE,L]
RewriteRule ^wpi-checkout/wpinv-receipt/?$ /faqs/#insurance [R=301,NE,L]
RewriteRule ^wpi-checkout/wpi-history/?$ /faqs/#insurance [R=301,NE,L]
RewriteRule ^wpi-checkout/?$ /faqs/#insurance [R=301,NE,L]
RewriteRule ^stripe-checkout-result/?$ /faqs/#insurance [R=301,NE,L]
RewriteRule ^payment-confirmation/?$ /faqs/#insurance [R=301,NE,L]
RewriteRule ^payment-failed/?$ /faqs/#insurance [R=301,NE,L]
RewriteRule ^asp-products/payment/?$ /faqs/#insurance [R=301,NE,L]
RewriteRule ^products/?$ /faqs/#insurance [R=301,NE,L]

# Prototype .html URLs
RewriteRule ^fees-and-insurance\.html$ /faqs/#insurance [R=301,NE,L]
# no aging content on the new site
RewriteRule ^insights/normal-memory-change-and-what-is-not\.html$ /insights/ [R=301,L]

# Feeds and the old Yoast sitemaps
RewriteRule ^feed/?$ /rss.xml [R=301,L]
RewriteRule ^comments/feed/?$ /rss.xml [R=301,L]
RewriteRule ^sitemap_index\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^post-sitemap\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^page-sitemap\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^category-sitemap\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^author-sitemap\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^asp-products-sitemap\.xml$ /sitemap.xml [R=301,L]

# Anything else under the retired plugin trees, or any other dated permalink from the old blog
RewriteRule ^wpi-checkout/.+$ /faqs/#insurance [R=301,NE,L]
RewriteRule ^asp-products/.+$ /faqs/#insurance [R=301,NE,L]
RewriteRule ^20[0-9]{2}/[0-9]{2}/.+$ /insights/ [R=301,L]

# ---------------------------------------------------------------------------
# Canonical host and scheme. One address per page, or the ranking splits.
# ---------------------------------------------------------------------------

RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.neuroaustin\.com$ [NC]
RewriteRule ^(.*)$ https://neuroaustin.com/$1 [R=301,L]

# ---------------------------------------------------------------------------
# Clean URLs. /about/ is the canonical form.
# ---------------------------------------------------------------------------

# Strip a trailing index.html
RewriteCond %{THE_REQUEST} \s/(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]

# Strip a .html extension a visitor typed. 404.html is exempt — it has no
# directory form.
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteCond %{THE_REQUEST} \s/([^.]+)\.html[\s?] [NC]
RewriteRule ^([^.]+)\.html$ /$1/ [R=301,L]

# Add the trailing slash to a bare directory name
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# ---------------------------------------------------------------------------
# Caching. The fonts are self-hosted and their filenames are stable, so a
# year-long immutable cache is right — but it also means a font swap needs a
# new filename, not just a new file.
# ---------------------------------------------------------------------------

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# 404
# ---------------------------------------------------------------------------

ErrorDocument 404 /404.html
