# Neuropsychology Specialists of Austin
# Apache / cPanel. If the site is served by Netlify or Vercel instead, this
# file is ignored — use _redirects or vercel.json.

Options -MultiViews
RewriteEngine On

# ---------------------------------------------------------------------------
# Canonical host and scheme. One address per page, or the ranking splits.
# ---------------------------------------------------------------------------

RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.neuroaustin\.com$ [NC]
RewriteRule ^(.*)$ https://neuroaustin.com/$1 [R=301,L]

# ---------------------------------------------------------------------------
# Clean URLs. /our-team/ is the canonical form; /our-team and /our-team.html
# both 301 to it.
# ---------------------------------------------------------------------------

# Strip a trailing index.html
RewriteCond %{THE_REQUEST} \s/(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]

# Strip a .html extension that a visitor typed
RewriteCond %{THE_REQUEST} \s/([^.]+)\.html[\s?] [NC]
RewriteRule ^([^.]+)\.html$ /$1/ [R=301,L]

# Add the trailing slash to a bare directory name
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# ---------------------------------------------------------------------------
# Old site -> new site.
#
# CONFIRMED old URLs only. The rest of the map has to be built from the live
# site's sitemap or from Search Console before launch — see REDIRECTS.md.
# A rule for a path that never existed is harmless; a missing rule is a lost
# ranking, so err toward adding them.
# ---------------------------------------------------------------------------

RewriteRule ^about-us/melissa-bunner-phd/?$ /our-team/ [R=301,L]
RewriteRule ^about-us/stephanie-paulos-phd/?$ /our-team/ [R=301,L]
RewriteRule ^about-us/?$ /our-team/ [R=301,L]

# LIKELY old WordPress paths. Verify each against the live site before launch
# and delete any that never existed.
RewriteRule ^contact-us/?$ /contact/ [R=301,L]
RewriteRule ^services/?$ /neuropsychological-evaluation/ [R=301,L]
RewriteRule ^neuropsychological-evaluation-2/?$ /neuropsychological-evaluation/ [R=301,L]
RewriteRule ^intervention/?$ /intervention-services/ [R=301,L]
RewriteRule ^fees/?$ /fees-and-payment/ [R=301,L]
RewriteRule ^fees-and-insurance/?$ /fees-and-payment/ [R=301,L]
RewriteRule ^insurance/?$ /fees-and-payment/ [R=301,L]
RewriteRule ^links/?$ / [R=301,L]

# The three 2018-2021 posts are retired. Their nearest equivalent is the blog
# index, not the home page — a mass redirect to the home page reads as a soft
# 404. Covers dated permalinks and /blog/ prefixes.
RewriteRule ^blog/?$ /insights/ [R=301,L]
RewriteRule ^blog/.+$ /insights/ [R=301,L]
RewriteRule ^20[0-9]{2}/[0-9]{2}/.+$ /insights/ [R=301,L]

# This build's own pre-launch preview paths.
RewriteRule ^fees-and-insurance\.html$ /fees-and-payment/ [R=301,L]
RewriteRule ^insights/normal-memory-change-and-what-is-not\.html$ /insights/ [R=301,L]

# ---------------------------------------------------------------------------
# 404
# ---------------------------------------------------------------------------

ErrorDocument 404 /404.html
